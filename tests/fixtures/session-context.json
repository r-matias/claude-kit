{
  "script": "session-context.sh",
  "cases": [
    { "name": "mostra branch, alterados e tarefas pendentes", "change": "src/App.cs",
      "plan": "# Plano\n- [x] 1. feito\n- [ ] 2. tarefa pendente\n", "exit": 0,
      "stdout": ["Branch: main", "src/App.cs", "- [ ] 2. tarefa pendente", "docs/specs/feat/PLAN.md (1/2)"], "stdout_not": ["1. feito"] },
    { "name": "sem git sai 0 sem saida", "cwd": "__NOGIT__", "exit": 0, "stdout_empty": true },
    { "name": "multi-repo: branch e alterados de cada repositorio",
      "workspace": { "repos": {
        "app": { "src/main.rs": "fn main() {}\n" },
        "web": { "src/home.ts": "x\n" } } },
      "change": "app/src/main.rs",
      "stdout": ["### app (branch: main)", "src/main.rs", "### web (branch: main)", "(sem alterações)"], "stdout_not": ["Branch: main"] },
    { "name": "compact: inclui o snapshot salvo", "source": "compact",
      "files": { ".claude/state/kit-snapshot.md": "MARCA-DO-SNAPSHOT\n" },
      "stdout": ["## Estado salvo antes da compactação", "MARCA-DO-SNAPSHOT"] },
    { "name": "compact: snapshot com mais de 2 horas nao entra", "source": "compact",
      "files": { ".claude/state/kit-snapshot.md": "MARCA-DO-SNAPSHOT\n" }, "touch": { ".claude/state/kit-snapshot.md": 180 },
      "stdout": ["Branch: main"], "stdout_not": ["MARCA-DO-SNAPSHOT"] },
    { "name": "startup: snapshot nao entra", "source": "startup",
      "files": { ".claude/state/kit-snapshot.md": "MARCA-DO-SNAPSHOT\n" },
      "stdout": ["Branch: main"], "stdout_not": ["MARCA-DO-SNAPSHOT"] },
    { "name": "plan_dirs faz o plano ativo aparecer",
      "kit": { "plan_dirs": [".claude/plans"] },
      "files": { ".claude/plans/recurso-x.md": "# X\n- [x] a\n- [ ] b\n- [ ] c\n" },
      "stdout": [".claude/plans/recurso-x.md (1/3)"] },
    { "name": "sem plan_dirs o plano fora de docs/specs nao aparece",
      "files": { ".claude/plans/recurso-x.md": "# X\n- [ ] b\n" },
      "stdout": ["Branch: main"], "stdout_not": ["recurso-x.md"] },
    { "name": "plano sem tarefa pendente nao e ativo",
      "plan": "# Plano\n- [x] 1. feito\n",
      "stdout": ["Branch: main"], "stdout_not": ["PLAN.md"] },
    { "name": "plano modificado ha mais de 14 dias nao e ativo",
      "plan": "# Plano\n- [ ] 1. pendente\n", "touch": { "docs/specs/feat/PLAN.md": 21600 },
      "stdout": ["Branch: main"], "stdout_not": ["PLAN.md"] },
    { "name": "UserPromptSubmit: sem inject_plan_on_prompt nao gera saida", "args": ["--plan-only"],
      "plan": "# Plano\n- [x] 1. feito\n- [ ] 2. pendente\n", "stdout_empty": true },
    { "name": "UserPromptSubmit: com inject_plan_on_prompt mostra o plano ativo", "args": ["--plan-only"],
      "kit": { "inject_plan_on_prompt": true },
      "plan": "# Plano\n- [x] 1. feito\n- [ ] 2. pendente\n",
      "stdout": ["Plano ativo do kit: docs/specs/feat/PLAN.md (1/2)"], "stdout_not": ["Branch:"] }
  ]
}
