{
  "script": "verify-gate.sh",
  "defaults": {
    "kit": {
      "diff_deny": [
        { "pattern": "^// @ts-ignore", "files": ["**/*.ts"], "message": "Supressão nova. Corrija a causa ou justifique na mesma linha." }
      ]
    },
    "files": { "src/a.ts": "const a = 1;\n// @ts-ignore antiga\n" }
  },
  "cases": [
    { "name": "diff_deny: linha nova com o padrao bloqueia com arquivo e linha",
      "edit": { "src/a.ts": "const a = 1;\n// @ts-ignore antiga\nconst b = 2;\n// @ts-ignore\nconst c = b;\n" }, "exit": 2,
      "stderr": ["[diff_deny] Supressão nova. Corrija a causa", "src/a.ts:4: // @ts-ignore", ".claude/kit-skip"],
      "stderr_not": "src/a.ts:2:" },
    { "name": "diff_deny: linha antiga com o padrao nao bloqueia", "change": "src/a.ts", "exit": 0 },
    { "name": "diff_deny: o padrao vale para o texto da linha, nao para o prefixo",
      "edit": { "src/a.ts": "const a = 1;\n// @ts-ignore antiga\nconst b = 2; // @ts-ignore\n" }, "exit": 0 },
    { "name": "diff_deny: arquivo novo nao rastreado conta inteiro",
      "edit": { "src/novo.ts": "export const x = 1;\n// @ts-ignore\n" }, "exit": 2,
      "stderr": "src/novo.ts:2: // @ts-ignore" },
    { "name": "diff_deny: diff.mnemonicPrefix do usuario nao esconde a linha nova",
      "env": { "GIT_CONFIG_COUNT": "1", "GIT_CONFIG_KEY_0": "diff.mnemonicPrefix", "GIT_CONFIG_VALUE_0": "true" },
      "edit": { "src/a.ts": "const a = 1;\n// @ts-ignore antiga\n// @ts-ignore\n" }, "exit": 2,
      "stderr": "src/a.ts:3: // @ts-ignore", "stderr_not": "src/a.ts:2:" },
    { "name": "diff_deny: diff.noprefix do usuario com arquivo numa pasta b/",
      "env": { "GIT_CONFIG_COUNT": "1", "GIT_CONFIG_KEY_0": "diff.noprefix", "GIT_CONFIG_VALUE_0": "true" },
      "files": { "b/x.ts": "const a = 1;\n" },
      "edit": { "b/x.ts": "const a = 1;\n// @ts-ignore\n" }, "exit": 2,
      "stderr": "  b/x.ts:2: // @ts-ignore" },
    { "name": "diff_deny: arquivo rastreado com espaco no nome",
      "files": { "src/meu arquivo.ts": "const a = 1;\n" },
      "edit": { "src/meu arquivo.ts": "const a = 1;\n// @ts-ignore\n" }, "exit": 2,
      "stderr": "  src/meu arquivo.ts:2: // @ts-ignore" },
    { "name": "diff_deny: arquivo fora de files nao bloqueia",
      "edit": { "docs/guia.md": "// @ts-ignore\n" }, "exit": 0 },
    { "name": "diff_deny: sem files vale para todo alterado, menos o proprio kit.json",
      "kit": { "diff_deny": [ { "pattern": "NAO-COMMITAR" } ] },
      "edit": { "docs/guia.md": "texto\nNAO-COMMITAR\n",
        ".claude/kit.json": { "commands": { "build": "true" }, "verify_on_stop": ["build"], "source_globs": ["**/*.cs"],
          "diff_deny": [ { "pattern": "NAO-COMMITAR", "message": "Marca NAO-COMMITAR em linha nova." } ] } }, "exit": 2,
      "stderr": ["Marca NAO-COMMITAR em linha nova.", "docs/guia.md:2: NAO-COMMITAR"], "stderr_not": ".claude/kit.json:" },
    { "name": "diff_deny: sem files e sem message usa o texto padrao",
      "kit": { "diff_deny": [ { "pattern": "NAO-COMMITAR" } ] },
      "edit": { "docs/guia.md": "NAO-COMMITAR\n" }, "exit": 2, "stderr": "Padrão proibido em linha nova." },
    { "name": "diff_deny: level warn nao bloqueia no gate",
      "kit": { "diff_deny": [ { "pattern": "^// @ts-ignore", "files": ["**/*.ts"], "level": "warn" } ] },
      "edit": { "src/novo.ts": "// @ts-ignore\n" }, "exit": 0 },
    { "name": "diff_deny: kit-skip libera, e apagado e registrado",
      "edit": { "src/novo.ts": "// @ts-ignore\n", ".claude/kit-skip": "biblioteca sem tipos, issue aberta\n" }, "exit": 0,
      "after": { "absent": [".claude/kit-skip"],
        "contains": { ".claude/kit-skip.log": "biblioteca sem tipos, issue aberta — liberado: Supressão nova." } } },
    { "name": "diff_deny: padrao invalido acusa a regra",
      "kit": { "diff_deny": [ { "pattern": "(", "files": ["**/*.ts"] } ] },
      "edit": { "src/novo.ts": "x\n" }, "exit": 2, "stderr": "padrão inválido em diff_deny[0]" },
    { "name": "diff_deny: mais de 20 linhas mostra 20 e conta o resto",
      "kit": { "diff_deny": [ { "pattern": "^proibido", "message": "Linha proibida." } ] },
      "edit": { "docs/lista.txt": "proibido 1\nproibido 2\nproibido 3\nproibido 4\nproibido 5\nproibido 6\nproibido 7\nproibido 8\nproibido 9\nproibido 10\nproibido 11\nproibido 12\nproibido 13\nproibido 14\nproibido 15\nproibido 16\nproibido 17\nproibido 18\nproibido 19\nproibido 20\nproibido 21\nproibido 22\n" },
      "exit": 2, "stderr": ["docs/lista.txt:20: proibido 20", "... e mais 2 linha(s)"], "stderr_not": "docs/lista.txt:21:" },
    { "name": "diff_deny: regra do kit.json de um repositorio filho, caminho relativo a ele",
      "workspace": { "repos": {
        "app": { ".claude/kit.json": { "diff_deny": [ { "pattern": "unsafe", "files": ["**/*.rs"], "message": "unsafe novo." } ] },
          "src/main.rs": "fn main() {}\n" },
        "web": { "src/home.ts": "x\n" } } },
      "edit": { "app/src/main.rs": "fn main() {}\nunsafe fn f() {}\n" }, "exit": 2,
      "stderr": ["[app] [diff_deny] unsafe novo.", "src/main.rs:2: unsafe fn f() {}"], "stderr_not": "app/src/main.rs:2:" },
    { "name": "diff_deny: regra da pasta-mae enxerga arquivo de repositorio filho",
      "workspace": { "repos": {
        "app": { "src/main.rs": "fn main() {}\n" },
        "web": { "src/home.ts": "x\n" } } },
      "files": { ".claude/kit.json": { "diff_deny": [ { "pattern": "console\\.log", "files": ["web/**"], "message": "console.log novo." } ] } },
      "edit": { "web/src/home.ts": "x\nconsole.log(1)\n" }, "exit": 2,
      "stderr": ["[diff_deny] console.log novo.", "web/src/home.ts:2: console.log(1)"] }
  ]
}
