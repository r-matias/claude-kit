{
  "script": "verify-gate.sh",
  "cases": [
    { "name": "stop_hook_active com verificacao ainda vermelha libera com systemMessage", "stop_hook_active": true, "change": "src/App.cs",
      "kit": { "commands": { "build": "echo build quebrou; false" } }, "exit": 0,
      "stdout": ["continuam depois da tentativa de correção", "build quebrou"],
      "json_check": ".systemMessage | contains(\"verificação vermelha\")" },
    { "name": "stop_hook_active com verificacao verde sai 0 sem saida", "stop_hook_active": true, "change": "src/App.cs", "exit": 0 },
    { "name": "kit.json invalido bloqueia o gate com aviso", "change": "src/App.cs",
      "files": { ".claude/kit.json": "{\"commands\":{\"build\":\"true\"},\"source_globs\":[\"**/*.cs\"],}" },
      "exit": 2, "stderr": "kit.json inválido" },
    { "name": "arquivo apagado nao entra em {files}", "change": "src/App.cs",
      "files": { "src/Old.cs": "x\n" }, "edit": { "src/Old.cs": null },
      "kit": { "commands": { "test_related": "test {files} = src/App.cs" } }, "exit": 0 },
    { "name": "so arquivo apagado: comando com {files} nao roda",
      "files": { "src/Old.cs": "x\n" }, "edit": { "src/Old.cs": null },
      "kit": { "commands": { "test_related": "false {files}" } }, "exit": 0 },
    { "name": "sem kit.json sai 0", "cwd": "__NOKIT__", "exit": 0 },
    { "name": "sem mudanca em source_globs sai 0", "change": "README.md",
      "kit": { "commands": { "test_related": "false" } }, "exit": 0 },
    { "name": "mudanca com verificacao verde sai 0", "change": "src/App.cs", "exit": 0 },
    { "name": "teste falhando sai 2", "change": "src/App.cs",
      "kit": { "commands": { "test_related": "echo 1 teste falhou; false" } }, "exit": 2, "stderr": "1 teste falhou" },
    { "name": "build falhando bloqueia", "change": "src/App.cs",
      "kit": { "commands": { "build": "echo build quebrou; false" } }, "exit": 2,
      "stderr": ["1 problema(s) neste turno", "'build' falhou"], "stderr_not": "'test_related' falhou" },
    { "name": "build e teste falhando: o teste roda mesmo assim e as duas falhas saem juntas", "change": "src/App.cs",
      "kit": { "commands": { "build": "echo build quebrou; false", "test_related": "echo 1 teste falhou; false" } }, "exit": 2,
      "stderr": ["2 problema(s) neste turno", "'build' falhou", "build quebrou", "'test_related' falhou", "1 teste falhou"],
      "stderr_order": ["'build' falhou", "'test_related' falhou"] },
    { "name": "uma falha mostra as ultimas 60 linhas", "change": "src/App.cs",
      "kit": { "commands": { "build": "seq -f 'linha %g' 1 100; false" } }, "exit": 2,
      "stderr": ["linha 41", "linha 100"], "stderr_not": "linha 40" },
    { "name": "duas falhas mostram as ultimas 30 linhas de cada", "change": "src/App.cs",
      "kit": { "commands": { "build": "seq -f 'linha %g' 1 100; false", "test_related": "seq -f 'teste %g' 1 100; false" } }, "exit": 2,
      "stderr": ["linha 71", "linha 100", "teste 71", "teste 100"], "stderr_not": ["linha 70", "teste 70"] },
    { "name": "saida longa de um comando e cortada no meio e nao esconde a outra falha", "change": "src/App.cs",
      "kit": { "commands": { "build": "seq -f '%0300g' 1 60; false" },
        "coupled_changes": [ { "when": ["src/**"], "require": ["manual/**"], "message": "Manual desatualizado." } ] }, "exit": 2,
      "stderr": ["2 problema(s) neste turno", "'build' falhou", "comando: seq", "cortado para caber no limite", "0060", "[coupled_changes] Manual desatualizado.", ".claude/kit-skip"],
      "stderr_order": ["'build' falhou", "cortado para caber no limite", "[coupled_changes] Manual desatualizado."] },
    { "name": "comando que le stdin nao consome a lista do gate", "change": "src/App.cs",
      "kit": { "commands": { "build": "cat >/dev/null; true", "test_related": "echo teste rodou; false" } }, "exit": 2,
      "stderr": "teste rodou" },
    { "name": "comando com files que nao casa com nenhum alterado nao roda", "change": "src/App.cs",
      "kit": { "commands": { "lint": { "run": "echo lint rodou; false", "files": ["**/*.ts"] } }, "verify_on_stop": ["build", "lint"] }, "exit": 0 },
    { "name": "comando com files recebe so os alterados que casam, mesmo fora de source_globs", "change": ["src/App.cs", "web/a.ts"],
      "kit": { "commands": { "lint": { "run": "echo lint recebeu {files}; false", "files": ["**/*.ts"] } }, "verify_on_stop": ["build", "lint"] }, "exit": 2,
      "stderr": ["'lint' falhou", "lint recebeu web/a.ts"], "stderr_not": "src/App.cs" },
    { "name": "comando com files roda sem source_globs", "change": "web/a.ts",
      "kit": { "commands": { "lint": { "run": "echo lint {files}; false", "files": ["**/*.ts"] } }, "verify_on_stop": ["lint"], "source_globs": [] }, "exit": 2,
      "stderr": "lint web/a.ts" },
    { "name": "comando com files e verde sai 0", "change": ["src/App.cs", "web/a.ts"],
      "kit": { "commands": { "lint": { "run": "test {files} = web/a.ts", "files": ["**/*.ts"] } }, "verify_on_stop": ["build", "lint"] }, "exit": 0 },
    { "name": "arquivo novo nao rastreado dispara o gate", "change": "src/Novo.cs",
      "kit": { "commands": { "test_related": "false" } }, "exit": 2 },
    { "name": "test_related recebe os arquivos alterados", "change": "src/App.cs",
      "kit": { "commands": { "test_related": "for f in {files}; do test -f \"$f\" || exit 1; done; test {files} = src/App.cs" } }, "exit": 0 },
    { "name": "chave ausente em commands e pulada", "change": "src/App.cs",
      "kit": { "verify_on_stop": ["build", "nao_existe"] }, "exit": 0 },
    { "name": "sem coupled_changes nem key_parity: tela e i18n alterados nao afetam o gate",
      "files": { "src/views/home.ts": "x\n", "strings/pt.json": { "a": 1 }, "strings/en.json": { "a": 1 } },
      "change": "src/views/home.ts", "edit": { "strings/pt.json": { "a": 1, "b": 2 } }, "exit": 0 },
    { "name": "sem coupled_changes nem key_parity: falha de teste identica a versao anterior", "change": "src/App.cs",
      "kit": { "commands": { "test_related": "echo 1 teste falhou; false" } }, "exit": 2,
      "stderr": ["kit verify-gate: 1 problema(s) neste turno.", "'test_related' falhou", "1 teste falhou"], "stderr_not": ["[key_parity]", "[coupled_changes]"] },
    { "name": "coupled_changes e key_parity vazios nao afetam o gate", "change": ["src/App.cs", "README.md"],
      "kit": { "coupled_changes": [], "key_parity": [] }, "exit": 0 }
  ]
}
